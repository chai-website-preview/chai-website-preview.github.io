---
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import PeopleArchive from "../../components/PeopleArchive.astro";
export async function getStaticPaths() {
  return (await getCollection("people")).map((p) => ({ params: { slug: p.data.slug }, props: { person: p } }));
}
const { person } = Astro.props;
---
<Site title={person.data.name} bodyClass="archive post-type-archive post-type-archive-people">
  <PeopleArchive openSlug={person.data.slug} />
</Site>
