---
import { getCollection, getEntry, render } from "astro:content";
import Site from "../layouts/Site.astro";
import PostBox from "../components/PostBox.astro";
import { newest } from "../lib/dates";

const home = await getEntry("pages", "center-for-human-compatible-artificial-intelligence");
const { Content } = await render(home!);
// "Highlights" on the live site = the four newest news posts, shown oldest-first, two per row.
const highlights = (await getCollection("news")).sort(newest).slice(0, 4).reverse();
const rows = [highlights.slice(0, 2), highlights.slice(2, 4)];
const youtubeId = "EBK-a94IFHY"; // hard-coded in the WordPress home template; not part of the exported content
---
<Site title="Center for Human-Compatible Artificial Intelligence" bodyClass="home page-template page-template-template-homepage template-homepage page page-id-9">
  <section id="banner">
    <header class="minor">
      <h2>Center for Human-Compatible AI <em>is building exceptional AI for humanity</em></h2>
      <a href="/about" class="button">Learn More</a>
    </header>
  </section>

  <section class="wrapper style1">
    <div class="container">
      <Content />
    </div>

    <div class="container">
      <header>
        <h2 id="highlights">Highlights</h2>
      </header>
      {rows.map((row) => (
        <div class="row">
          {row.map((post) => (
            <section class="6u 12u(narrower)">
              <PostBox post={post} section="news" />
            </section>
          ))}
        </div>
      ))}
    </div>

    <div class="container" style="text-align: center; margin: 0 auto">
      <iframe width="560" height="315" src={`https://www.youtube.com/embed/${youtubeId}`} title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
    </div>
  </section>

  <section class="wrapper style2" id="mailinglist">
    <div class="container">
      <header class="minor">
        <h2 id="subscribe-to-our-mailing-list">Subscribe to our mailing list</h2>
        <p>If you would like to receive our newsletters and updates, then please subscribe.</p>
      </header>
      <div class="row 50%">
        <div class="6u 12u(mobile)">
          <!-- Begin MailChimp Signup Form -->
          <div id="mc_embed_signup">
            <form action="https://smithamilli.us10.list-manage.com/subscribe/post?u=c13f8b85f7eaca0cffaab48fa&amp;id=7dd2a6f4e4" method="post" id="mc-embedded-subscribe-form" name="mc-embedded-subscribe-form" class="validate" target="_blank" novalidate>
              <div id="mc_embed_signup_scroll">
                <div class="mc-field-group">
                  <input type="email" value="" placeholder="Email" name="EMAIL" class="required email" id="mce-EMAIL" />
                </div>
                <div id="mce-responses" class="clear">
                  <div class="response" id="mce-error-response" style="display:none"></div>
                  <div class="response" id="mce-success-response" style="display:none"></div>
                </div>
                <!-- real people should not fill this in and expect good things - do not remove this or risk form bot signups-->
                <div style="position: absolute; left: -5000px;" aria-hidden="true"><input type="text" name="b_c13f8b85f7eaca0cffaab48fa_78e62de175" tabindex="-1" value="" /></div>
                <br />
                <div class="clear"><input type="submit" value="Subscribe" name="subscribe" id="mc-embedded-subscribe" class="button alt" /></div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Site>
