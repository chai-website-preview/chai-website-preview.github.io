---
/**
 * /bibliography ("Annotated Bibliography of Recommended Materials") as the Blade template rendered it.
 * The inline <style>, priority-threshold <script>, intro and TOC copy are verbatim from the live page
 * (src/snippets). Category order and per-entry order come from the live site via tools/apply_live_order.py;
 * media-group order per category is the term's `media` meta.
 */
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import taxonomies from "../data/taxonomies.json";
import style from "../snippets/bibliography-style.html?raw";
import script from "../snippets/bibliography-script.html?raw";
import intro from "../snippets/bibliography-intro.html?raw";

const DEFAULT_THRESHOLD = 2; // entries with priority <= 2 are visible on load
const items = await getCollection("bibliography");
const terms = taxonomies["bibliography-category"] as Array<{ slug: string; name: string; parent: string | null; description: string | null; order?: number; media?: string; toc_description?: string }>;
const byOrder = (a: { order?: number; name: string }, b: { order?: number; name: string }) => (a.order ?? 1e9) - (b.order ?? 1e9) || a.name.localeCompare(b.name);
const supercats = terms.filter((t) => !t.parent).sort(byOrder).map((sc) => ({
  ...sc,
  cats: terms.filter((t) => t.parent === sc.slug).sort(byOrder).map((c) => {
    const entries = items.filter((r) => r.data.categories.includes(c.slug)).sort((a, b) =>
      (a.data.order?.[c.slug] ?? 1e9) - (b.data.order?.[c.slug] ?? 1e9) || (a.data.priority ?? 9) - (b.data.priority ?? 9) || a.data.wp_id - b.data.wp_id);
    const mediaOrder = (c.media ?? "").split(",").map((m) => m.trim()).filter(Boolean);
    const groups = mediaOrder.map((m) => ({ media: m, entries: entries.filter((e) => e.data.media === m) })).filter((g) => g.entries.length);
    return { ...c, groups };
  }),
}));
const visible = (p?: number) => (p ?? 9) <= DEFAULT_THRESHOLD;
const btnColor = (i: number) => (i <= DEFAULT_THRESHOLD ? "background-color: rgb(149, 199, 59);" : "background-color: rgb(238, 238, 238);");
---
<Site title="Recommended Materials" bodyClass="archive post-type-archive post-type-archive-bibliography">
  <Fragment set:html={style} />
  <section class="wrapper style1">
    <div class="container">
      <div id="content">
        <header>
          <h2 id="annotated-bibliography-of-recommended-materials">Annotated Bibliography of Recommended Materials</h2>
        </header>
        <Fragment set:html={intro} />
        {supercats.map((sc) => (
          <>
            <h3 class="bib-supercategory" id={sc.slug}>{sc.name}</h3>
            {sc.cats.map((c) => (
              <>
                <h4 class="bib-category" id={c.slug}>{c.name}</h4>
                <div class="bib-category-description" set:html={c.description ?? ""} />
                <div class="bib-set-priority">
                  Set your priority threshold for this category: <br />
                  <div class="bib-button-break"></div>
                  {[1, 2, 3, 4, 5].map((i) => (
                    <div class={`bib-button ${c.slug} ${i}`} style={btnColor(i)}><button class="bib-button" onclick={`return set_threshold('${c.slug}', ${i});`}>{i}</button></div>
                  ))}
                </div>
                {c.groups.map((g) => (
                  <>
                    <h5 class:list={["bib-media", c.slug, { "bib-visible": g.entries.some((e) => visible(e.data.priority)) }]}>{g.media}:</h5>
                    {g.entries.map((e) => (
                      <div class:list={["bib-entry", c.slug, String(e.data.priority ?? ""), { "bib-visible": visible(e.data.priority) }]}>
                        <span class="bib-entry-title"><span class={`bib-entry-priority-${e.data.priority}`}>({e.data.priority})</span> {e.data.url ? <a href={e.data.url}>{e.data.title}</a> : e.data.title}, {e.data.author}.</span>
                        <div class="bib-entry-description" set:html={e.data.notes_html ?? ""} />
                      </div>
                    ))}
                  </>
                ))}
              </>
            ))}
          </>
        ))}
      </div>
    </div>
  </section>
  <Fragment set:html={script} />
</Site>
