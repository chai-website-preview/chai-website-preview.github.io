---
/** Static pages (About, Contact, Donate, ...): the theme's default page template. */
import { getCollection, render } from "astro:content";
import Site from "../layouts/Site.astro";
export async function getStaticPaths() {
  const pages = await getCollection("pages", (p) => p.data.wp_id !== 9);
  return pages.map((p) => ({ params: { slug: p.data.slug }, props: { page: p } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---
<Site title={page.data.title} bodyClass={`page-template-default page page-id-${page.data.wp_id}`}>
  <section class="wrapper style1">
    <div class="container">
      <div id="content">
        <article>
          <header>
            <h2>{page.data.title}</h2>
          </header>
          <Content />
        </article>
      </div>
    </div>
  </section>
</Site>
