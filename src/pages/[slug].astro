---
/** Static pages (About, Contact, Donate, ...): the theme's default page template. */
import { getCollection, render } from "astro:content";
import Site from "../layouts/Site.astro";
export async function getStaticPaths() {
  // Excluded: the home page (9) and the WordPress "posts page" stubs for News (92) and Blog (1873).
  // Those three have empty bodies and their paths are served by index.astro and the
  // news/blog [...page].astro listings; without this they collide and blank those pages out.
  const STUBS = new Set([9, 92, 1873]);
  const pages = await getCollection("pages", (p) => !STUBS.has(p.data.wp_id));
  return pages.map((p) => ({ params: { slug: p.data.slug }, props: { page: p } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---
<Site title={page.data.title} bodyClass={`page-template-default page page-id-${page.data.wp_id}`}>
  <section class="wrapper style1">
    <div class="container">
      <div id="content">
        <article>
          <header>
            <h2>{page.data.title}</h2>
          </header>
          <Content />
        </article>
      </div>
    </div>
  </section>
</Site>
