---
/**
 * /people/ as the Sage theme rendered it: one <section> per association (fixed list & order, as in the
 * Blade template), cards sorted by WP post_name, each card followed by its Bootstrap modal.
 * A person's own URL (/people/<slug>/) renders this same page and opens their modal.
 */
import { getCollection, render } from "astro:content";
import ThemeImage from "./ThemeImage.astro";

interface Props { openSlug?: string }
const { openSlug } = Astro.props;

// The live template lists exactly these associations, in this order ("In Memoriam" exists in the data
// but is not rendered on the live page). The Graduate Students section carries a stray "<p> </p>"
// on the live site; reproduced for parity.
const SECTIONS = [
  ["faculty", "Faculty"], ["staff", "Staff"], ["researchers", "Researchers"], ["research-fellows", "Research Fellows"],
  ["visiting-scholars", "Visiting Scholars"], ["alumni", "Alumni"], ["affiliates", "Affiliates"],
  ["graduate-students", "Graduate Students"], ["affiliated-graduate-students", "Affiliated Graduate Students"],
  ["interns", "Interns"], ["former-interns", "Former Interns"],
] as const;

const people = await getCollection("people");
const bySlug = (a: typeof people[number], b: typeof people[number]) =>
  (a.data.sort_slug ?? a.data.slug).localeCompare(b.data.sort_slug ?? b.data.slug);
const sections = [];
for (const [id, name] of SECTIONS) {
  const members = people.filter((p) => p.data.associations.includes(name)).sort(bySlug);
  if (!members.length) continue;
  sections.push({ id, name, members: await Promise.all(members.map(async (p) => ({ p, Bio: (await render(p)).Content }))) });
  // bio_html is what WordPress printed (stored HTML, no wpautop); the Markdown body is the editable copy.
}
// role: stored as text; the theme ran wpautop on it (blank line -> new <p>, single newline -> <br>)
const roleParas = (r?: string) => (r ?? "").split(/\n\s*\n/).map((p) => p.trim().split(/\n/)).filter((p) => p[0]);
---
<section class="wrapper style1">
  <div class="container">
    <div id="content">
      <article>
        <header>
          <h2 id="people">People</h2>
        </header>
        {sections.map(({ id, name, members }) => (
          <section>
            <h3 id={id}>{name}</h3>
            {id === "graduate-students" && <p>
</p>}
            <div class="people">
              {members.map(({ p, Bio }) => (
                <>
                  <div class="box person">
                    <a href={`/people/#${p.data.slug}`} data-toggle="modal" class="image" data-target={`#modal_${p.data.slug}`}>
                      <div class="image-container">
                        {p.data.photo && <ThemeImage src={p.data.photo} width={400} alt={p.data.name} />}
                        <div class="corner-fade corner-fade-on-dark"></div>
                        <div class="corner-plus"></div>
                      </div>
                    </a>
                    <br />
                    <a href={`/people/#${p.data.slug}`} data-toggle="modal" data-target={`#modal_${p.data.slug}`}>{p.data.name}</a>
                    <div class="person-title">
                      {roleParas(p.data.role).map((lines) => <p>{lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>)}
                    </div>
                  </div>
                  <div class="modal fade person-modal" id={`modal_${p.data.slug}`} tabindex="-1" role="dialog" aria-labelledby="trackingLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                      <div class="modal-content">
                        <div class="modal-body">
                          <button type="button" class="button close-modal" data-dismiss="modal" aria-hidden="true">×</button>
                          <h3>{p.data.name}</h3>
                          {p.data.photo && <ThemeImage src={p.data.photo} width={600} alt={p.data.name} class="image right no-float-narrower" />}
                          <h4>{roleParas(p.data.role).map((lines) => <p>{lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>)}</h4>
                          {p.data.bio_html !== undefined ? <Fragment set:html={p.data.bio_html} /> : <Bio />}
                        </div>
                      </div>
                    </div>
                  </div>
                </>
              ))}
            </div>
          </section>
        ))}
      </article>
    </div>
  </div>
</section>
<script is:inline define:vars={{ openSlug }}>
  // Verbatim from the live template (opens the modal named in the URL hash, keeps the hash in sync),
  // plus: a person's own URL opens their modal directly.
  window.onload = function () {
    var path = window.location.href;
    if (path.indexOf("#") > -1) {
      var person = path.slice(path.indexOf("#") + 1);
      jQuery("#modal_" + person).modal("show");
    } else if (openSlug) {
      jQuery("#modal_" + openSlug).modal("show");
    }
    jQuery(".modal").on("show.bs.modal", function (e) {
      if (typeof e.relatedTarget != "undefined") {
        window.location.hash = jQuery(e.relatedTarget).attr("href");
      }
    });
  };
</script>
