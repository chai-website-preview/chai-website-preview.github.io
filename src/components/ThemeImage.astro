---
/**
 * An optimized image rendered the way the Verti theme expects: a bare <img> with NO width/height
 * attributes. The theme's CSS sizes images with `width:100%` / `max-width:100%` and never sets
 * `height:auto`, so Astro's <Image> (which writes explicit dimensions) would render them stretched.
 */
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props { src: ImageMetadata; width: number; alt: string; class?: string; loading?: "lazy" | "eager" }
const { src, width, alt, class: className, loading = "lazy" } = Astro.props;
const img = await getImage({ src, width });
---
<img src={img.src} alt={alt} class={className} loading={loading} decoding="async" />
