---
/**
 * Pixel-port of the live humancompatible.ai chrome (Sage theme wrapping the HTML5 UP "Verti" design).
 * The DOM, ids and classes are kept identical to the live site so the theme's own main.css / main.js
 * apply unchanged: main.js builds the desktop dropdowns (dropotron) and the mobile #titleBar/#navPanel
 * from #nav at runtime, exactly as WordPress did.
 */
import menu from "../data/menu.json";
interface Props { title: string; bodyClass?: string }
const { title, bodyClass = "" } = Astro.props;
const nav = menu["nav-bar"];
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (url: string | null) => url && (url.split("#")[0].replace(/\/$/, "") || "/") === here;
const siteTitle = "Center for Human-Compatible Artificial Intelligence";
---
<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap" rel="stylesheet" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <title>{title === siteTitle ? `${siteTitle} – Center for Human-Compatible AI is building exceptional AI for humanity` : `${title} – ${siteTitle}`}</title>
    <link rel="stylesheet" href="/app/themes/chai/dist/wp-block-library.css" />
    <link rel="stylesheet" href="/app/themes/chai/dist/main.css" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body class={bodyClass}>
    <div id="header">
      <h1>
        <a href="/" id="logo">
          <img class="chai-logo" src="/app/themes/chai/dist/images/chai-logo_a729cbef.png" alt="Center for Human-Compatible AI" />
        </a>
      </h1>
    </div>

    <nav id="nav" class="menu-nav-bar-container">
      <ul id="menu-nav-bar" class="navigation">
        {nav.map((item) => {
          const kids = item.children ?? [];
          const current = isCurrent(item.url) || kids.some((k) => isCurrent(k.url));
          return (
            <li class:list={["menu-item", { "menu-item-has-children": kids.length > 0, opener: kids.length > 0, "current-menu-item": current }]}>
              <a href={item.url} aria-current={isCurrent(item.url) ? "page" : undefined}>{item.label}</a>
              {kids.length > 0 && (
                <ul class="">
                  {kids.map((k) => (
                    <li class:list={["menu-item", { "current-menu-item": isCurrent(k.url) }]}><a href={k.url}>{k.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <main id="page-wrapper">
      <slot />
    </main>

    <div id="footer">
      <div class="container">
        <div class="copyright">
          <ul class="menu">
            <li>© UC Berkeley Center for Human-Compatible AI. </li><li>Design: <a href="http://html5up.net/">HTML5 UP</a></li>
          </ul>
        </div>
      </div>
    </div>

    <script is:inline src="/app/themes/chai/dist/jquery.min.js"></script>
    <script is:inline src="/app/themes/chai/dist/jquery-migrate.min.js"></script>
    <script is:inline src="/app/themes/chai/dist/main.js"></script>
  </body>
</html>
