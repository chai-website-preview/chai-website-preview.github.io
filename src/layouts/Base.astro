---
import "../styles/global.css";
import menu from "../data/menu.json";
interface Props { title: string; wide?: boolean }
const { title, wide = false } = Astro.props;
const nav = menu["nav-bar"];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · CHAI</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Center for Human-Compatible AI</a>
      <nav>
        {nav.map((item) => <a href={item.url}>{item.label}</a>)}
      </nav>
    </header>
    <main class:list={{ wide }}>
      <slot />
    </main>
    <footer>Preview build · content migrated from WordPress. Dashed orange boxes mark raw HTML blocks that still need hand cleanup.</footer>
  </body>
</html>
